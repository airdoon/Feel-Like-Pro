# Copy this file to .env and fill in real values. Never publish .env.
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Google OAuth: create a Web application OAuth client in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram bot username WITHOUT @ and bot token from @BotFather
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# Steam Web API key (optional for OpenID sign-in; used to fetch profile details)
STEAM_API_KEY=
