# Public hostname only, without scheme. Point its DNS A record to the VPS.
DOMAIN=example.com
BASE_URL=https://example.com
PORT=3000
NODE_ENV=production

# Create a bot with @BotFather; configure /setdomain for DOMAIN.
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_TOKEN=replace-with-real-bot-token
# Comma-separated Telegram numeric IDs of platform administrators.
TELEGRAM_ADMIN_IDS=123456789

# Generate a long random secret; never commit the real .env file.
SESSION_SECRET=replace-this-with-at-least-32-random-characters

# Docker: use a strong URL-safe password (letters/digits recommended).
POSTGRES_PASSWORD=replace-with-long-random-alphanumeric-password
# Local development URL; Docker Compose sets DATABASE_URL inside the app container.
DATABASE_URL=postgres://flp:replace-with-long-random-alphanumeric-password@localhost:5432/flp
